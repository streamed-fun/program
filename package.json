{
  "name": "@streamed-fun/program",
  "version": "0.2.0",
  "description": "The streamed.fun curve program, and the JavaScript mirror that is tested against it",
  "license": "UNLICENSED",
  "type": "module",
  "main": "js/index.js",
  "exports": {
    ".": "./js/index.js",
    "./curve": "./js/curve.js",
    "./events": "./js/events.js",
    "./program": "./js/program.js",
    "./tx": "./js/tx.js"
  },
  "files": [
    "js",
    "programs",
    "idl.json",
    "SPEC.md",
    "SECURITY.md"
  ],
  "scripts": {
    "test": "node --test \"js/**/*.test.js\"",
    "vectors": "node scripts/gen-curve-vectors.mjs",
    "program:build": "cd programs/streamed_coin && cargo build-sbf",
    "program:test": "cargo test --workspace",
    "program:id": "node scripts/set-program-id.mjs",
    "program:deploy": "node scripts/deploy-program.mjs",
    "program:init": "node scripts/init-global.mjs",
    "program:idl": "node scripts/upload-idl.mjs",
    "program:verify": "node scripts/verify-program.mjs",
    "program:gate": "node scripts/devnet-gate.mjs"
  }
}
